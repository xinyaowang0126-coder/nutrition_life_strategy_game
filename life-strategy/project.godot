; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="好好吃饭"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/branding/haohaochifan-512.png"
config/windows_native_icon="res://assets/branding/haohaochifan.ico"
boot_splash/image="res://assets/branding/haohaochifan-256.png"
boot_splash/bg_color=Color(0.961, 0.925, 0.851, 1)

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/window_width_override.windows=1280
window/size/window_height_override.windows=720

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/release_guard/plugin.cfg")

[health_guidance_v2]

data=false
engine=false
ui=false
weekly=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
