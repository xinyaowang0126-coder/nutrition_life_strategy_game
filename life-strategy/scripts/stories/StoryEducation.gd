class_name StoryEducation
extends RefCounted

const LESSONS := {
	1: {"title": "灶台上的隔夜菜", "line": "昨晚的菜在室温放了12小时，早餐得换一份。", "body": "昨晚20:00做的青菜，今早08:00还在灶台上。这盘菜应丢弃，闻着正常也不能证明安全；再烧开也可能留有耐热毒素。\n\n剩菜要及时、卫生地冷藏，吃之前查看保存时间，按要求再热。\n\n来源：香港食物安全中心《处理剩余食物》；食环署《食物卫生守则》。"},
	2: {"title": "给自己做顿饭", "line": "米饭、蛋、豆腐、青菜，今天搭配着选。", "body": "这一餐有哪些原料？可以对照米饭、粥、蛋、豆腐和蔬菜来看。\n\n菜名多，原料未必多。要看吃得够不够，还得知道份量和一整天吃了什么。\n\n来源：《中国老年人膳食指南（2022）》一般老年人核心推荐；国家卫健委2024年6月6日发布会。"},
	3: {"title": "盐勺以外的钠", "line": "酱油也有钠，算算这次用了多少。", "body": "练习标签：酱油每100毫升含钠7000毫克。用10毫升，就有700毫克钠，约折合1.75克食盐；用5毫升，就是350毫克钠。\n\n买到的酱油要看瓶身标签。上面只算了这部分酱油，食物本身和其他调味品中的钠另算。\n\n中国2022指南的一般成人参照为每天食盐不超过5克，需合计一整天。\n\n来源：中国营养学会2022准则五；WHO《Healthy diet》盐钠说明。"},
	4: {"title": "一瓶饮料有多少糖", "line": "标签写的是每100毫升，整瓶还得换算一下。", "body": "练习标签：一瓶饮料250毫升，每100毫升含总糖8克，整瓶就是20克总糖。添加糖的来源没写清，它的量仍未知。总糖、添加糖和碳水化合物要分开看。\n\n中国2022指南建议每天添加糖不超过50克，最好控制在25克以下。这个参照针对添加糖，无需吃满，也不要求取消主食、奶类或完整水果。\n\n来源：中国营养学会2022准则五；国家卫健委GB 28050-2025问答。"},
	5: {"title": "练完一起吃饭", "line": "周阿姨：‘苹果有点硬，今天想煮软了吃。’", "body": "周阿姨觉得硬苹果嚼着费劲，想试试切小或煮软。蒸蛋和炖豆腐也是她今天想吃的。\n\n午饭后可以问问老陈，练完要不要一起吃晚饭。请他来家里，就要准备两人份食材；去家常小馆，各付各的饭钱。\n\n来源：中国老年人膳食指南的共同就餐建议；人物具体情境。"},
	6: {"title": "给下一餐留一份", "line": "多做的一份先分出来，放进冰箱。", "body": "本关的备餐做法：上桌前用清洁浅盒分装，1小时内放进4℃冰箱并连续冷藏。下次只取当餐的一份，彻底再热至中心至少75℃。不反复再热，冷藏超过3天应丢弃。\n\n易腐熟食在室温超过4小时应丢弃，放回冰箱或再热也不能重新计算保存时间。\n\n来源：香港食物安全中心《处理剩余食物》《自备餐盒》。"},
	7: {"title": "今晚有演出", "line": "晚饭后汇演：排练至少70，精力至少25，留一个安排位。", "body": "今晚演出。排练要达到70，演前精力至少25，还得留一个安排位。\n\n早饭后、午饭后都可以补练或休息。先看看还差什么，再安排今天。"},
}


static func lesson(day: int) -> Dictionary:
	return LESSONS.get(day, {}).duplicate(true)


static func exercise(day: int) -> Dictionary:
	if day == 3:
		return {"question": "给定标签：每100毫升钠7000毫克。用了10毫升，这部分钠是多少？", "correct": "700", "explanation": "7000 × 10 ÷ 100 = 700毫克钠，约折合1.75克食盐。其他食物和调味品还需计入。", "choices": [{"id": "70", "text": "70毫克钠"}, {"id": "700", "text": "700毫克钠"}, {"id": "7000", "text": "7000毫克钠"}]}
	if day == 4:
		return {"question": "给定标签：250毫升饮料，每100毫升总糖8克。配方未写清糖的来源，该怎样记录？", "correct": "total_known", "explanation": "8 × 250 ÷ 100 = 20克总糖。添加糖的量仍未知，不能用总糖或碳水化合物替代。", "choices": [{"id": "added", "text": "20克添加糖"}, {"id": "total_known", "text": "20克总糖；添加糖量未知"}, {"id": "zero", "text": "没写添加糖，就记为零"}]}
	return {}
