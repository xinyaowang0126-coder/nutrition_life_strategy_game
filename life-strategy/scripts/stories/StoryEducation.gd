class_name StoryEducation
extends RefCounted

const LESSONS := {
	1: {"title": "灶台上的隔夜菜", "line": "这盘菜在室温放了12小时，应丢弃；闻着正常也不能证明安全。", "body": "昨晚20:00做的青菜，今早08:00仍在灶台。储存不当的熟食有食物中毒风险，再烧开不能保证消除部分耐热毒素。\n\n及时、卫生地冷藏的备餐要按保存和再热条件处理，不能把所有隔夜菜都判成有害。\n\n科普依据：香港食物安全中心《处理剩余食物》；食环署《食物卫生守则》。"},
	2: {"title": "自己的饭也要做好", "line": "老年人也需要多样食物和蛋白质来源，清淡饮食仍要合理搭配。", "body": "比较粥配咸菜与加上蛋、豆腐和蔬菜的一餐。鱼、禽、蛋、肉、奶及大豆制品可在不同餐中按口味和条件安排。奶类也是蛋白质和钙的来源。\n\n有这些食物，不等于已经吃够：还要看份量和全天安排。吃得下的做法、食欲与共同进餐也值得关注。\n\n科普依据：《中国老年人膳食指南（2022）》一般老年人核心推荐；国家卫健委2024年6月6日发布会。"},
	3: {"title": "盐勺以外的钠", "line": "酱油、咸菜和其他食物里的钠也要算，标签要按实际份量读。", "body": "给定教学标签：酱油每100毫升钠7000毫克。用了10毫升，这部分钠就是700毫克，约折合1.75克食盐。换成5毫升，这部分钠为350毫克。\n\n这是模拟标签，不能代表所有酱油。食物本身及其他调味品还需计入；未记录的量不能当零。\n\n中国2022指南一般成人参照：每天食盐不超过5克，是全天参照。\n\n科普依据：中国营养学会2022准则五；WHO《Healthy diet》盐钠说明。"},
	4: {"title": "一份麦片，一整瓶饮料", "line": "看整份含量，也看配料：总糖、添加糖和碳水化合物是不同指标。", "body": "给定教学标签：饮料250毫升，每100毫升总糖8克，整瓶总糖20克。添加糖来源没写清，就不能直接计为20克添加糖。乳饮料还可能有本来存在的乳糖。\n\n中国2022指南建议每天添加糖不超过50克，最好控制在25克以下。这不是必须吃满的量，也不意味着要取消主食、奶类或完整水果。\n\n科普依据：中国营养学会2022准则五；国家卫健委GB 28050-2025问答。"},
	5: {"title": "练完一起吃饭", "line": "硬食物不好嚼时，先了解困难，再试切小、蒸软或换种做法。", "body": "周阿姨觉得硬苹果不好嚼，这是她自己的困难。可以试切小或煮软；蛋白质来源也有蒸蛋、豆腐等可选择的做法。\n\n关心包括了解喜欢吃什么、哪里不方便，以及一起安排一顿饭。不能因为年龄就要求所有人只喝粥，也不能在游戏中诊断吞咽问题。\n\n科普依据：中国老年人膳食指南的共同就餐建议；人物具体情境。"},
	6: {"title": "雨天的小份备餐", "line": "按人数做，计划留存的份量上桌前分出，并及时冷藏。", "body": "本关卡备餐条件：清洁浅盒分装，1小时内放进4℃冰箱并连续冷藏；食用前只取一份彻底再热至中心至少75℃。不反复再热，冷藏超过3天应弃掉。\n\n易腐熟食在室温超过4小时应丢弃。放回冰箱或再热不能清零已经发生的温度暴露。\n\n科普依据：香港食物安全中心《处理剩余食物》《自备餐盒》。"},
	7: {"title": "自己的舞台", "line": "今天晚饭后演出：排练达到70，演前至少保留25游戏精力。", "body": "安排好三餐、休息和活动，完成自己在意的事情。\n\n排练进度和精力是游戏刻度。演出成功只表示完成本局任务；营养状况要结合真实摄入、个体情况和专业评估。\n\n回顾实际记录：哪些餐比较单一？怎样买小份、处理剩菜？下一次能做什么调整？"},
}


static func lesson(day: int) -> Dictionary:
	return LESSONS.get(day, {}).duplicate(true)


static func exercise(day: int) -> Dictionary:
	if day == 3:
		return {"question": "给定标签：每100毫升钠7000毫克。用了10毫升，这部分钠是多少？", "correct": "700", "explanation": "7000 × 10 ÷ 100 = 700毫克钠，约折合1.75克食盐。其他食物和调味品还需计入。", "choices": [{"id": "70", "text": "70毫克钠"}, {"id": "700", "text": "700毫克钠"}, {"id": "7000", "text": "7000毫克钠"}]}
	if day == 4:
		return {"question": "给定标签：250毫升饮料，每100毫升总糖8克。配方未写清糖的来源，该怎样记录？", "correct": "total_known", "explanation": "8 × 250 ÷ 100 = 20克总糖。添加糖的量仍未知，不能用总糖或碳水化合物替代。", "choices": [{"id": "added", "text": "20克添加糖"}, {"id": "total_known", "text": "20克总糖；添加糖量未知"}, {"id": "zero", "text": "没写添加糖，就记为零"}]}
	return {}
