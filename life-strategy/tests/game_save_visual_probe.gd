extends "res://tests/story_series_visual_probe.gd"

const Game := preload("res://scenes/game_v2/GameRootV2.tscn")
const Session := preload("res://scripts/stories/StorySession.gd")


func _run() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--output="): output = arg.trim_prefix("--output=")
	DirAccess.make_dir_recursive_absolute(output)
	Session.request("choir_week")
	var game := Game.instantiate() as GameRootV2
	root.add_child(game)
	current_scene = game
	await settle()
	await click(game.new_day_popup.continue_button)
	await finish_household_opening(game)
	await source_tool(game, "kitchen")
	await click(game._workspace.find_child("before_week_greens", true, false))
	await click(game._workspace.close_button)
	await click(game._active_stage.find_child("home_kitchen", true, false))
	game._on_food_toggled("rice_plain")
	game._on_food_toggled("tofu")
	await click(game._active_stage._get_confirm_button())
	await workspace_click(game, game._workspace.option_buttons["storage:fridge"])
	await click(game._workspace.confirm_button)
	await settle()
	check(game._save_status.text == "已保存", "Auto save did not acknowledge")
	var ingredients := game.kitchen.ingredients.duplicate(true)
	await click(game.menu_button)
	await save("01-progress-menu")
	await workspace_click(game, game._workspace.find_child("save", true, false))
	await save("02-manual-slots")
	await workspace_click(game, game._workspace.find_child("manual_1", true, false))
	await save("03-saved")
	await click(game._story_dialog._buttons.get_node("close"))
	var action: Control = game._active_stage._cards_by_id["rehearse"]
	game._active_stage.action_scroll.ensure_control_visible(action)
	await settle()
	await click(action)
	check(game.phase == "lunch_source", "Rehearsal did not advance")
	await click(game.menu_button)
	await workspace_click(game, game._workspace.find_child("load", true, false))
	await save("04-load-slots")
	await workspace_click(game, game._workspace.find_child("manual_1", true, false))
	await save("05-read-confirmation")
	await click(game._story_dialog._buttons.get_node("read"))
	check(game.phase == "breakfast_action", "Manual read did not restore phase")
	check(game.state["goal_progress"] == 0, "Manual read replayed rehearsal")
	check(game.kitchen.ingredients == ingredients, "Manual read replayed ingredient debit")
	await save("06-restored")
	await click(game.menu_button)
	await workspace_click(game, game._workspace.find_child("menu", true, false))
	await settle()
	var menu := current_scene
	await click(menu._title_start)
	await click(menu._strips["zhou_huilan_66"])
	await settle()
	await save("07-continue-story")
	await click(menu._restart)
	await save("08-restart-confirmation")
	await click(menu._dialog._buttons.get_node("cancel"))
	await click(menu._main_start)
	await settle()
	game = current_scene as GameRootV2
	check(game.phase == "breakfast_action", "Fresh scene replayed opening")
	check(game.kitchen.ingredients == ingredients, "Fresh scene reset stock")
	check(game.today_meal_records.size() == 1, "Fresh scene duplicated meal")
	await save("09-continued")
	var result := {"errors": errors, "window": str(DisplayServer.window_get_size()), "phase": game.phase, "scope": "Native input with memory backend: auto ack, manual slot, read, menu continue, restart cancel. File persistence is tested separately; not browser acceptance."}
	var file := FileAccess.open(output.path_join("report.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify(result, "\t"))
	print("SAVE_VISUAL_RESULT=" + JSON.stringify(result))
	quit(0 if errors.is_empty() else 1)
