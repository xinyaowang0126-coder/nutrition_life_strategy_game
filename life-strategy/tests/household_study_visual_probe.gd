extends "res://tests/story_keyboard_visual_probe.gd"

const Study := preload("res://scripts/stories/HouseholdMealLearning.gd")
const Codec := preload("res://scripts/stories/GameSaveCodec.gd")
const Controller := preload("res://scripts/ui_v2/GameRootV2.gd")
const Deck := preload("res://scripts/systems/MealDeckService.gd")
var cases: Array[Dictionary] = []


func _run() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--output="): output = arg.trim_prefix("--output=")
	DirAccess.make_dir_recursive_absolute(output)
	if OS.get_cmdline_user_args().has("--restore-only"):
		for name in ["sodium-question", "sodium-feedback", "sugar-feedback"]:
			var game := await restore(name)
			var active: Dictionary = game.household_lessons["active"]
			check(not active.is_empty() and game._workspace.name == "MealStudyPage", "Restart did not restore study: " + name)
			await save("restart-" + name)
			var entry := Study.entry(game.household_lessons, active["entry_id"])
			var before := resources(game)
			var plan: Dictionary = active["return"]["plan"].duplicate(true)
			await click(game._workspace.close_button)
			check(game._workspace is CookingPlanStage and game._workspace.plan == plan, "Restart lost the draft recipe")
			check(resources(game) == before, "Restart/close spent resources")
			cases.append({"case": name, "attempts": entry["attempt_count"], "first": entry["attempts"][0] if not entry["attempts"].is_empty() else {}})
			game.queue_free()
			await process_frame
	else:
		await composition_case()
		await sodium_case()
		await sugar_case()
	var result := {"errors": errors, "cases": cases, "window": str(root.size), "scope": "Actual native mouse/keyboard from valid day-2/3/4 saves generated by legal prior-day commands. Recipe study, retry, help, transfer and return use input; day 4 finishes through real stages. Restore-only is a separate process. Not a continuous seven-day browser run or a physical phone."}
	var file := FileAccess.open(output.path_join("restart-report.json" if OS.get_cmdline_user_args().has("--restore-only") else "report.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify(result, "\t"))
	print("HOUSEHOLD_STUDY_VISUAL=" + JSON.stringify(result))
	quit(0 if errors.is_empty() else 1)


func fixture(day: int) -> GameRootV2:
	var model := Controller.new()
	model.story_id = "choir_week"
	model.health_history_path = ""
	model._deck_service = Deck.new(42)
	model.start_new_run()
	for previous_day in range(1, day):
		for meal in ["breakfast", "lunch", "dinner"]:
			model._choose_meal_source("breakfast_shop" if meal == "breakfast" else "community_canteen")
			var plate: Array[String] = []
			for id in model.hand:
				model.selected_food_ids = plate.duplicate()
				if model._can_add_food(id): plate.append(id)
				if plate.size() == 2: break
			check(model.confirm_household_food(plate), "Prior-day meal failed")
			model._apply_action("nap")
		model._choose_sleep("sleep_early")
		model._on_summary_advanced()
	check(model.day == day, "Fixture did not reach the requested day")
	var snapshot := Codec.encode(model.capture_game_save())
	check(snapshot["ok"], "Fixture save rejected")
	model.free()
	Session.request_saved(Codec.decode(snapshot["text"])["save"])
	var game := Game.instantiate() as GameRootV2
	game.health_history_path = ""
	root.add_child(game)
	current_scene = game
	await settle()
	return game


func resources(game: GameRootV2) -> Dictionary:
	return {"state": game.state.duplicate(true), "ingredients": game.kitchen.ingredients.duplicate(true), "condiments": game.kitchen.condiments.duplicate(true), "batches": game.kitchen.batches.duplicate(true), "meals": game.today_meal_records.duplicate(true), "selected": game.selected_food_ids.duplicate()}


func composition_case() -> void:
	var game := await fixture(2)
	await source_pick(game, "home_kitchen")
	await choose_from(game, ["rice_plain", "oatmeal", "millet_porridge"])
	await choose_from(game, ["egg", "tofu", "steamed_egg", "greens"])
	await save("01-composition-menu")
	var before := resources(game)
	await click(game._active_stage.learning_button)
	await save("02-composition-question")
	await key(KEY_TAB)
	check(game._workspace.is_ancestor_of(root.gui_get_focus_owner()), "Study Tab escaped the modal")
	await study_click(game, "enough")
	await study_click(game, "Retry")
	await study_click(game, "known")
	await save("03-first-answer-and-retry")
	check(not game.household_lessons["entries"][0]["attempts"][0]["correct"], "Retry replaced the first wrong answer")
	await click(game._workspace.close_button)
	check(resources(game) == before, "Composition practice spent resources or selected food")
	check(game._active_stage is HouseholdMealStage, "Composition did not return to selection")
	cases.append({"case": "composition", "entries": game.household_lessons["entries"].size(), "attempts": game.household_lessons["entries"][0]["attempt_count"]})
	game.queue_free()
	await process_frame


func sodium_case() -> void:
	var game := await fixture(3)
	await source_pick(game, "home_kitchen")
	await choose_supported(game, "seasonable")
	await choose_supported(game, "sweetenable")
	await click(game._active_stage._get_confirm_button())
	await workspace_click(game, game._workspace.option_buttons["seasoning:usual"])
	await workspace_click(game, game._workspace.option_buttons["sugar:8"])
	await workspace_click(game, game._workspace.option_buttons["storage:fridge"])
	var before := resources(game)
	await workspace_click(game, game._workspace.learning_button)
	snapshot(game, "sodium-question")
	await save("04-current-sodium-question")
	await study_click(game, "per100")
	await study_click(game, "Retry")
	await study_click(game, "measured")
	await study_click(game, "Transfer")
	await save("05-sodium-transfer-label")
	await study_click(game, "measured")
	snapshot(game, "sodium-feedback")
	await key(KEY_ESCAPE)
	check(game._workspace.plan == {"seasoning": "usual", "added_sugar_g": 8} and game._workspace.storage == "fridge", "Recipe return lost seasoning or storage")
	check(resources(game) == before, "Sodium practice spent resources")
	await save("06-returned-draft")
	await click(game._workspace.confirm_button)
	check(game.today_meal_records[0]["recipe_facts"]["sodium_from_added_seasonings_mg"] == 1500, "Transfer label changed the actual recipe")
	check(game.today_meal_records[0]["learning_facts"]["scope"] == "confirmed", "Confirmed meal did not freeze learning facts")
	cases.append({"case": "sodium", "entries": game.household_lessons["entries"].size(), "actual_sodium": game.today_meal_records[0]["recipe_facts"]["sodium_from_added_seasonings_mg"]})
	game.queue_free()
	await process_frame


func sugar_case() -> void:
	var game := await fixture(4)
	await source_pick(game, "home_kitchen")
	await choose_supported(game, "sweetenable")
	await choose_from(game, ["egg", "tofu", "steamed_egg", "soft_tofu_greens"])
	await click(game._active_stage._get_confirm_button())
	await workspace_click(game, game._workspace.option_buttons["sugar:4"])
	var before := resources(game)
	await workspace_click(game, game._workspace.learning_button)
	await save("07-current-sugar-question")
	await study_click(game, "Explain")
	check(game.household_lessons["entries"][0]["attempt_count"] == 0, "Explanation was counted as an answer")
	await save("08-explanation-without-answer")
	await study_click(game, "Retry")
	await study_click(game, "known")
	await study_click(game, "Transfer")
	await study_click(game, "added")
	await study_click(game, "Retry")
	await study_click(game, "total_known")
	snapshot(game, "sugar-feedback")
	await save("09-total-versus-added-history")
	await click(game._workspace.close_button)
	check(game._workspace.plan["added_sugar_g"] == 4 and resources(game) == before, "Sugar practice changed the meal")
	await click(game._workspace.confirm_button)
	await click(game._active_stage.skip_button)
	await source_pick(game, "home_fridge")
	await choose_from(game, ["milk"])
	await choose_from(game, ["apple"])
	await click(game._active_stage._get_confirm_button())
	await click(game._active_stage.skip_button)
	await source_pick(game, "home_kitchen")
	await choose_from(game, ["rice_plain", "millet_porridge", "oatmeal"])
	await choose_from(game, ["egg", "tofu", "steamed_egg"])
	await choose_from(game, ["greens", "tomato", "soft_tofu_greens"])
	await click(game._active_stage._get_confirm_button())
	await click(game._workspace.confirm_button)
	await click(game._active_stage.skip_button)
	var early: Control = game._active_stage._cards_by_id["sleep_early"]
	game._active_stage.sleep_scroll.ensure_control_visible(early)
	await settle()
	await click(early)
	check(game.phase == "summary", "Actual day-4 route did not reach summary")
	var observation: Dictionary = game.run_history.back()["learning_observation"]
	check(observation["known_white_sugar_g"] == 4, "Teaching label was counted as actual sugar")
	await save("10-actual-day-four-summary")
	cases.append({"case": "sugar", "entries": game.household_lessons["entries"].size(), "actual_white_sugar": observation["known_white_sugar_g"], "meals": game.today_meal_records.size()})
	game.queue_free()
	await process_frame


func choose_from(game: GameRootV2, preferred: Array) -> void:
	for id in preferred:
		if not game.selected_food_ids.has(id) and game.hand.has(id) and game._can_add_food(id):
			var card: Control = game._active_stage._cards_by_id[id]
			game._active_stage.food_scroll.ensure_control_visible(card)
			await settle()
			await click(card)
			return
	check(false, "No available food for " + str(preferred))


func choose_supported(game: GameRootV2, attribute: String) -> void:
	for id in game.hand:
		if String(game._story_food(id).get(attribute, "false")) == "true" and game._can_add_food(id):
			await choose_from(game, [id])
			return
	check(false, "No actual menu food supports " + attribute)


func study_click(game: GameRootV2, id: String) -> void:
	var button: Button = game._workspace.find_child(id, true, false)
	if game._workspace.scroll.is_ancestor_of(button): game._workspace.scroll.ensure_control_visible(button)
	await settle()
	await click(button)


func source_pick(game: GameRootV2, id: String) -> void:
	var stage := game._active_stage as HouseholdSourceStage
	check(stage != null, "Source stage is not visible")
	if stage == null: return
	# An illustration's transparent center is intentionally not a hit target.
	# Click the visible nameplate, which is part of the real button hit mask.
	await click(stage._props[id].get_node("Nameplate"))
	check(game._is_meal_phase(), "Nameplate did not open the source: " + id)


func snapshot(game: GameRootV2, name: String) -> void:
	var encoded := Codec.encode(game.capture_game_save())
	check(encoded["ok"], "Study save did not encode: " + name)
	if encoded["ok"]:
		var file := FileAccess.open(output.path_join(name + ".json"), FileAccess.WRITE)
		file.store_string(encoded["text"])


func restore(name: String) -> GameRootV2:
	var decoded := Codec.decode(FileAccess.get_file_as_string(output.path_join(name + ".json")))
	check(decoded["ok"], "Study save did not decode: " + name)
	Session.request_saved(decoded["save"])
	var game := Game.instantiate() as GameRootV2
	game.health_history_path = ""
	root.add_child(game)
	current_scene = game
	await settle()
	return game
